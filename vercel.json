{
  "buildCommand": "node build.cjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/funis/500-moldes-ceramica-fria/pagina-vendas.html"
    },
    {
      "source": "/promo",
      "destination": "/funis/500-moldes-ceramica-fria/promo.html"
    },
    {
      "source": "/(.*)",
      "destination": "/funis/500-moldes-ceramica-fria/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
